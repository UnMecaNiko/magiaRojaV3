# Configuración del proxy inverso. Un bloque por dominio.
# Los certificados TLS se piden y renuevan solos; no hay certbot ni cron.

{
	email {$ACME_EMAIL}
}

# Cabeceras y compresión comunes a todos los sitios.
(comunes) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# ── Landing de VELO inc (Next.js) ──────────────────────────────
{$DOMINIO_VELO} {
	import comunes

	# Los assets con hash de Next son inmutables: cache larga.
	@estaticos path /_next/static/*
	header @estaticos Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy web-velo:3000
}

# www redirige al apex, para no dividir el SEO entre dos direcciones.
www.{$DOMINIO_VELO} {
	redir https://{$DOMINIO_VELO}{uri} permanent
}

# ── n8n ────────────────────────────────────────────────────────
{$DOMINIO_N8N} {
	import comunes
	reverse_proxy n8n:5678
}

# ── Presentación "Sistema operativo de IA" ─────────────────────
# Exportación estática de un Next.js (`output: "export"`), servida como
# archivos: no hay proceso Node detrás. El contenido se sube a
# /opt/proxy/sitios/theker — ver la sección "Sitios estáticos" del README.
{$DOMINIO_THEKER} {
	import comunes

	root * /srv/theker

	# Los assets con hash de Next son inmutables: cache larga.
	@estaticos path /_next/static/*
	header @estaticos Cache-Control "public, max-age=31536000, immutable"

	# La exportación escribe una página por ruta como `<ruta>.html`.
	try_files {path} {path}.html {path}/index.html
	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

# ── Tercer sitio ───────────────────────────────────────────────
# Descomentar cuando se defina su subdominio, añadir DOMINIO_TRES al .env,
# crear su registro A y reiniciar Caddy. El certificado se emite solo.
# Si en vez de estático es una app, cambiar root+file_server por:
#   reverse_proxy web-tres:3000
#
# {$DOMINIO_TRES} {
# 	import comunes
# 	root * /srv/sitio-dos
