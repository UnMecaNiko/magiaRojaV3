# Copiar a .env en el servidor y completar. NO se commitea.

# Correo para los avisos de expiración de Let's Encrypt.
ACME_EMAIL=correo@ejemplo.com

# Un dominio por sitio. Deben tener un registro A apuntando a la IP del VPS
# ANTES de levantar el stack, o la emisión del certificado falla.
DOMINIO_VELO=maquina.ejemplo.com
DOMINIO_N8N=n8n.ejemplo.com
DOMINIO_DOS=otro.ejemplo.com
