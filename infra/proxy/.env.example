# Copiar a .env en el servidor y completar. NO se commitea.

# Correo para los avisos de expiración de Let's Encrypt.
ACME_EMAIL=correo@ejemplo.com

# Cada dominio necesita un registro A apuntando a la IP del VPS ANTES de
# levantar el stack, o la emisión del certificado falla.
# El bloque de www se genera solo a partir de DOMINIO_VELO.
# DOMINIO_THEKER es un subdominio de unmecaniko.com (DNS en Huawei Cloud),
# no de velasquezlopez.com. theker.velasquezlopez.com redirige 301 a este.
DOMINIO_VELO=velasquezlopez.com
DOMINIO_N8N=n8n.velasquezlopez.com
DOMINIO_THEKER=presalesagent.unmecaniko.com

# Tercer sitio: descomentar aquí y en el Caddyfile cuando se defina.
# DOMINIO_TRES=otro.velasquezlopez.com
