# Configuración del proxy inverso. Un bloque por dominio.
# Los certificados TLS se piden y renuevan solos; no hay certbot ni cron.

{
	email {$ACME_EMAIL}
}

# Cabeceras y compresión comunes a todos los sitios.
(comunes) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# ── Portada de VELO inc (estática) ─────────────────────────────
# Desde el 2026-09-18 el apex es la portada, no la landing de la CNC.
# El contenido se sube a /opt/proxy/sitios/velasquezlopez — ver la sección
# "Sitios estáticos" del README. No hay proceso Node detrás.
{$DOMINIO_VELO} {
	import comunes

	root * /srv/velasquezlopez

	# La raíz elige idioma por la cabecera del navegador. 302, no 301: la
	# respuesta depende de Accept-Language y no puede cachearse como fija.
	# El Vary evita que un proxy le sirva /en/ a un navegador en español.
	@home path /
	header @home Vary Accept-Language

	@home_es {
		path /
		header_regexp Accept-Language (?i)^\s*es\b
	}
	redir @home_es /es/ 302
	redir @home /en/ 302

	# Las fuentes propias llevan el nombre del peso: son inmutables.
	@fuentes path /media/fonts/*
	header @fuentes Cache-Control "public, max-age=31536000, immutable"

	try_files {path} {path}.html {path}/index.html
	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

# www redirige al apex, para no dividir el SEO entre dos direcciones.
www.{$DOMINIO_VELO} {
	redir https://{$DOMINIO_VELO}{uri} permanent
}

# ── Landing de la CNC (Next.js) ────────────────────────────────
# Vivía en el apex hasta el 2026-09-18. Al mudarla hay que cambiar
# NEXT_PUBLIC_SITE_URL en el .env de la landing y reconstruirla, o seguirá
# anunciando el apex como su dirección canónica.
{$DOMINIO_CNC} {
	import comunes

	# Los assets con hash de Next son inmutables: cache larga.
	@estaticos path /_next/static/*
	header @estaticos Cache-Control "public, max-age=31536000, immutable"

	reverse_proxy web-velo:3000
}

# ── n8n ────────────────────────────────────────────────────────
{$DOMINIO_N8N} {
	import comunes
	reverse_proxy n8n:5678
}

# ── Presentación "Sistema operativo de IA" ─────────────────────
# Exportación estática de un Next.js (`output: "export"`), servida como
# archivos: no hay proceso Node detrás. El contenido se sube a
# /opt/proxy/sitios/theker — ver la sección "Sitios estáticos" del README.
# Dirección canónica desde 2026-09-18: presalesagent.unmecaniko.com
{$DOMINIO_THEKER} {
	import comunes

	root * /srv/theker

	# Los assets con hash de Next son inmutables: cache larga.
	@estaticos path /_next/static/*
	header @estaticos Cache-Control "public, max-age=31536000, immutable"

	# Idioma del navegador en la raíz. 302, no 301: la respuesta depende
	# de Accept-Language. Misma regla que velasquezlopez.com (Nicolas, 2026-09-18).
	@home path /
	header @home Vary Accept-Language

	@home_es {
		path /
		header_regexp Accept-Language (?i)^\s*es\b
	}
	redir @home_es /es/ 302
	redir @home /en/ 302

	# La exportación escribe una página por ruta como `<ruta>/index.html`.
	try_files {path} {path}.html {path}/index.html
	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}

# Dominio anterior (2026-07-30). El 301 conserva los enlaces ya publicados.
theker.velasquezlopez.com {
	redir https://{$DOMINIO_THEKER}{uri} permanent
}

# ── Tercer sitio ───────────────────────────────────────────────
# Descomentar cuando se defina su subdominio, añadir DOMINIO_TRES al .env,
# crear su registro A y reiniciar Caddy. El certificado se emite solo.
# Si en vez de estático es una app, cambiar root+file_server por:
#   reverse_proxy web-tres:3000
#
