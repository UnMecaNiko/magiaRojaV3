# Copiar a .env en el servidor y completar. NO se commitea.

# Debe coincidir con DOMINIO_N8N del proxy.
DOMINIO_N8N=n8n.ejemplo.com

# Generar con:  openssl rand -base64 24
POSTGRES_PASSWORD=

# Generar con:  openssl rand -hex 32
# ⚠️ Guardar una copia fuera del servidor. Si se pierde, las credenciales
#    de todos los flujos quedan irrecuperables.
N8N_ENCRYPTION_KEY=

TZ=America/Bogota
